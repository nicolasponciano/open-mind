    "check": "npm run test && npm run test:powershell && npm run test:curator && npm run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
